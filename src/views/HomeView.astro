---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../features/about/About.astro';
import Contact from '../features/contact/Contact.astro';
import Code from '../features/ide/Code.astro';
import Education from '../features/education/Education.astro';
import Experience from '../features/experience/Experience.astro';
import Hero from '../features/hero/Hero.astro';
import Projects from '../features/projects/Projects.astro';
import Skills from '../features/skills/Skills.astro';
import { SITE } from '../config/site';
import { getEducation, getExperience, getProfile, getProjects, getSkills } from '../data/queries';
import type { Locale } from '../i18n/locales';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const [profile, experience, education, projects, skills] = await Promise.all([
  getProfile(locale),
  getExperience(locale),
  getEducation(locale),
  getProjects(locale),
  getSkills(locale),
]);
---
<BaseLayout
  {locale}
  title={`${SITE.name} — ${profile.role}`}
  description={profile.tagline}
  jobTitle={profile.role}
>
  <Hero {locale} {profile} />
  <Code {locale} {profile} {experience} {education} {projects} groups={skills.groups} />
  <About {locale} {profile} />
  <Skills {locale} groups={skills.groups} />
  <Experience {locale} items={experience} />
  <Education {locale} items={education} />
  <Projects {locale} {projects} />
  <Contact {locale} />
</BaseLayout>
