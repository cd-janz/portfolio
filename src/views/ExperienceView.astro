---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceTimeline from '../features/experience/ExperienceTimeline.astro';
import PageHeader from '../ui/PageHeader.astro';
import { SITE } from '../config/site';
import { getExperience, getProfile } from '../data/queries';
import { localePath } from '../i18n/paths';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/locales';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = ui(locale);
const [profile, experience] = await Promise.all([getProfile(locale), getExperience(locale)]);
---
<BaseLayout {locale} path="experience" current="experience" onHome={false} title={`${t.pages.experience.title} — ${SITE.name}`} description={t.pages.experience.lead} jobTitle={profile.role}>
  <PageHeader eyebrow={t.sections.experience} title={t.pages.experience.title} lead={t.pages.experience.lead} backHref={localePath(locale)} backLabel={t.pages.back} />
  <div class="container wrap">
    <ExperienceTimeline {locale} items={experience} detailed level="h2" />
  </div>
</BaseLayout>

<style>
  .wrap { padding-bottom: var(--space-24); }
</style>
