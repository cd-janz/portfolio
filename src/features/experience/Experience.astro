---
import Section from '../../ui/Section.astro';
import { localePath } from '../../i18n/paths';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';
import ExperienceTimeline from './ExperienceTimeline.astro';
import type { ExperienceEntry } from './to-view';

interface Props { locale: Locale; items: ExperienceEntry[]; }
const { locale, items } = Astro.props;
const t = ui(locale);
---
<Section id="experience" eyebrow={t.sections.experience} title={t.titles.experience} more={{ href: localePath(locale, 'experience'), label: t.more.experience }}>
  <ExperienceTimeline {locale} {items} />
</Section>
