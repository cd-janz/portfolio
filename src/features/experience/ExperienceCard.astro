---
import Icon from '../../ui/Icon.astro';
import Tag from '../../ui/Tag.astro';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';
import type { ExperienceView } from './to-view';

interface Props {
  locale: Locale;
  entry: ExperienceView;
  /** Home shows a summary; the detail page shows everything. */
  detailed?: boolean;
  level?: 'h2' | 'h3';
}
const { locale, entry: e, detailed = false, level: Heading = 'h3' } = Astro.props;
const t = ui(locale);

const SUMMARY_IMPACT = 3;
const SUMMARY_STACK = 6;
const impact = detailed ? e.achievements : e.achievements.slice(0, SUMMARY_IMPACT);
const stack = detailed ? e.stack : e.stack.slice(0, SUMMARY_STACK);
const hiddenStack = e.stack.length - stack.length;
---
<li class="entry">
  <span class="node" class:list={{ live: e.current }} aria-hidden="true"></span>
  <article class="card">
    <header class="head">
      <div>
        <Heading>{e.role}</Heading>
        <p class="company">
          {e.url
            ? <a href={e.url} target="_blank" rel="noopener noreferrer">{e.company}<Icon name="link" size="0.9em" /></a>
            : e.company}
          <span class="where"> · {e.location} · {e.mode}</span>
        </p>
      </div>
      <p class="when"><Icon name="calendar" size="1em" />{e.period}<b>{e.duration}</b></p>
    </header>
    <p class="summary">{e.summary}</p>
    {detailed && e.responsibilities.length > 0 && (
      <div class="block">
        <p class="label">{t.experience.responsibilities}</p>
        <div class="tags">{e.responsibilities.map((r) => <Tag tone="accent">{r}</Tag>)}</div>
      </div>
    )}
    <ul class="impact">{impact.map((a) => <li>{a}</li>)}</ul>
    <div class="tags">
      {stack.map((s) => <Tag>{s}</Tag>)}
      {hiddenStack > 0 && <Tag>{`+${hiddenStack} ${t.experience.moreStack}`}</Tag>}
    </div>
  </article>
</li>

<style>
  .entry { position: relative; }
  .node { position: absolute; left: calc(var(--space-8) * -1); top: 28px; width: 16px; height: 16px; border-radius: 50%; background: var(--bg); border: 2px solid var(--accent); }
  .node.live { background: var(--accent); box-shadow: 0 0 0 6px var(--accent-soft); }
  .card { display: grid; gap: var(--space-4); padding: var(--space-8); border: 1px solid var(--border); border-radius: var(--radius-lg); background: color-mix(in oklab, var(--surface) 88%, transparent); transition: border-color 0.25s, transform 0.3s var(--ease); }
  .card:hover { border-color: color-mix(in oklab, var(--accent) 45%, var(--border)); transform: translateX(4px); }
  .head { display: flex; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; align-items: start; }
  .head :global(h2), .head :global(h3) { font-size: 2rem; }
  .company { margin-top: 4px; color: var(--accent); }
  .company a { display: inline-flex; align-items: center; gap: 6px; }
  .company a:hover { text-decoration: underline; }
  .where { color: var(--text-muted); font-size: 0.9rem; }
  .when { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted); }
  .when b { font-weight: 500; padding: 0.15rem 0.6rem; border-radius: var(--radius-pill); border: 1px solid var(--border-strong); color: var(--text); }
  .summary { color: var(--text-muted); max-width: 70ch; }
  .block { display: grid; gap: var(--space-2); }
  .label { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-faint); }
  .impact { display: grid; gap: var(--space-2); }
  .impact li { position: relative; padding-left: 1.4rem; font-size: 0.97rem; }
  .impact li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 8px; height: 2px; background: var(--accent); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  @media (max-width: 640px) { .node { left: calc(var(--space-6) * -1); } .card { padding: var(--space-6); } }
</style>
