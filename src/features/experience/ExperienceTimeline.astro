---
import type { Locale } from '../../i18n/locales';
import { ui } from '../../i18n/ui';
import ExperienceCard from './ExperienceCard.astro';
import { toExperienceView, type ExperienceEntry } from './to-view';

interface Props { locale: Locale; items: ExperienceEntry[]; detailed?: boolean; level?: 'h2' | 'h3'; }
const { locale, items, detailed, level } = Astro.props;
const t = ui(locale);
const views = items.map((item) => toExperienceView(item, locale, t.experience.present));
---
<ol class="timeline">
  {views.map((entry) => <ExperienceCard {locale} {entry} {detailed} {level} />)}
</ol>

<style>
  .timeline { position: relative; display: grid; gap: var(--space-8); padding-left: var(--space-8); }
  .timeline::before { content: ''; position: absolute; left: 7px; top: 8px; bottom: 8px; width: 2px; background: linear-gradient(var(--accent), var(--border) 70%, transparent); }
  @media (max-width: 640px) { .timeline { padding-left: var(--space-6); } }
</style>
