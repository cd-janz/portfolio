---
import Button from '../../ui/Button.astro';
import type { Profile } from '../../schemas/profile';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';

interface Props { locale: Locale; profile: Profile; }
const { locale, profile } = Astro.props;
const t = ui(locale);
// Highlight the last words of the headline with the accent gradient.
const words = profile.headline.split(' ');
const lead = words.slice(0, -3).join(' ');
const accent = words.slice(-3).join(' ');
---
<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="container inner">
    <p class="badge"><span class="dot" aria-hidden="true"></span>{t.hero.eyebrow}</p>
    <h1 id="hero-title">{lead} <span class="grad">{accent}</span></h1>
    <p class="tagline">{profile.tagline}</p>
    <div class="cta">
      <Button href="#contact">{t.hero.cta}</Button>
      <Button href="#projects" variant="ghost">{t.hero.secondaryCta}</Button>
    </div>
    <p class="meta">{profile.role} · {profile.location} · {t.hero.available}</p>

    <dl class="stats">
      {profile.stats.map((s) => (
        <div class="stat"><dt>{s.label}</dt><dd>{s.value}</dd></div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero { min-height: 100svh; display: grid; align-items: center; padding-top: calc(var(--header-h) + var(--space-8)); padding-bottom: var(--space-16); }
  .inner { display: grid; justify-items: start; gap: var(--space-6); }
  .badge { display: inline-flex; align-items: center; gap: var(--space-2); padding: 0.35rem 0.9rem; border-radius: var(--radius-pill); border: 1px solid var(--border-strong); background: color-mix(in oklab, var(--surface) 80%, transparent); font-size: 0.85rem; color: var(--text-muted); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 0 var(--success); animation: pulse 2.2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 9px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  h1 { font-size: clamp(2.6rem, 7.2vw, 5.4rem); max-width: 16ch; text-wrap: balance; }
  .grad { background: linear-gradient(100deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .tagline { max-width: 58ch; font-size: clamp(1.05rem, 2vw, 1.25rem); color: var(--text-muted); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }
  .meta { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-faint); }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: var(--space-4); width: 100%; margin: var(--space-8) 0 0; padding-top: var(--space-8); border-top: 1px solid var(--border); }
  .stat { display: flex; flex-direction: column-reverse; gap: 2px; }
  dt { color: var(--text-muted); font-size: 0.9rem; }
  dd { margin: 0; font-family: var(--font-display); font-size: 2.4rem; font-weight: 600; letter-spacing: -0.03em; }
</style>
