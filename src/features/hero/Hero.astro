---
import Button from '../../ui/Button.astro';
import { decoration } from '../../ui/decorations';
import type { Profile } from '../../schemas/profile';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';

interface Props { locale: Locale; profile: Profile; }
const { locale, profile } = Astro.props;
const t = ui(locale);
// Highlight the last words of the headline with the accent gradient.
const words = profile.headline.split(' ');
const lead = words.slice(0, -3).join(' ');
const accent = words.slice(-3).join(' ');
---
<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="container inner">
    <p class="badge"><span class="dot" aria-hidden="true"></span>{t.hero.eyebrow}</p>
    <h1 id="hero-title">{lead} <span class="mark"><span class="grad">{accent}</span><span class="curve" aria-hidden="true" set:html={decoration('curve-decoration')} /></span></h1>
    <p class="tagline">{profile.tagline}</p>
    <div class="cta">
      <Button href="#contact">{t.hero.cta}</Button>
      <Button href="#projects" variant="ghost">{t.hero.secondaryCta}</Button>
    </div>
    <p class="meta">{profile.role} · {profile.location} · {t.hero.available}</p>

    <dl class="stats">
      {profile.stats.map((s) => (
        <div class="stat"><dt>{s.label}</dt><dd>{s.value}</dd></div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero { min-height: 100svh; display: grid; align-items: center; padding-top: calc(var(--header-h) + var(--space-16)); padding-bottom: var(--space-24); }
  .inner { display: grid; justify-items: center; text-align: center; gap: var(--space-8); }
  .badge { display: inline-flex; align-items: center; gap: var(--space-2); padding: 0.35rem 0.9rem; border-radius: var(--radius-pill); border: 1px solid var(--border-strong); background: color-mix(in oklab, var(--surface) 80%, transparent); font-size: 0.85rem; color: var(--text-muted); margin-bottom: calc(var(--space-2) * -1); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 0 var(--success); animation: pulse 2.2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 9px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  h1 { font-size: clamp(3.4rem, 9.5vw, 7.4rem); max-width: 18ch; text-wrap: balance; line-height: 0.92; }
  .mark { position: relative; display: inline-block; isolation: isolate; }
  .curve { position: absolute; z-index: -1; left: -2%; right: -2%; bottom: -0.09em; height: 0.26em; color: var(--accent); opacity: 0.8; pointer-events: none; }
  .curve :global(svg) { width: 100%; height: 100%; overflow: visible; }
  .curve :global(path) { stroke-width: 0.09em; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.1s 0.5s var(--ease) forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .grad { background: linear-gradient(100deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .tagline { max-width: 62ch; text-wrap: balance; font-size: clamp(1.05rem, 2vw, 1.25rem); color: var(--text-muted); }
  .cta { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-2); }
  .meta { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-faint); }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: var(--space-4); align-items: start; width: 100%; margin: var(--space-8) 0 0; padding-top: var(--space-8); border-top: 1px solid var(--border); }
  .stat { display: flex; flex-direction: column-reverse; align-items: center; gap: 2px; }
  dt { color: var(--text-muted); font-size: 0.9rem; }
  dd { margin: 0; font-family: var(--font-display); font-size: 3.4rem; font-weight: 600; letter-spacing: -0.03em; }
</style>
