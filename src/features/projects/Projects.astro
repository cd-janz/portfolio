---
import Section from '../../ui/Section.astro';
import type { ProjectItem } from '../../data/queries';
import { localePath } from '../../i18n/paths';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';
import ProjectsGrid from './ProjectsGrid.astro';

interface Props { locale: Locale; projects: ProjectItem[]; }
const { locale, projects } = Astro.props;
const t = ui(locale);
const featured = projects.filter((p) => p.featured);
---
<Section id="projects" eyebrow={t.sections.projects} title={t.titles.projects} more={{ href: localePath(locale, 'projects'), label: t.more.projects }}>
  <ProjectsGrid {locale} projects={featured} />
</Section>
