---
import { render } from 'astro:content';
import Tag from '../../ui/Tag.astro';
import type { ProjectItem } from '../../data/queries';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';

interface Props { locale: Locale; project: ProjectItem; }
const { locale, project } = Astro.props;
const t = ui(locale);
const { Content } = await render(project.entry);
const dialogId = `project-${project.id}`;
---
<article class="card">
  <button class="open" type="button" data-open-dialog={dialogId} aria-label={`${t.projects.details}: ${project.name}`}></button>
  <div class="media" style={`--seed:${project.id.length * 47 % 360}`}>
    {project.picture
      ? <img src={project.picture} alt="" loading="lazy" decoding="async" />
      : <span class="mono" aria-hidden="true">{project.name.slice(0, 2).toUpperCase()}</span>}
    {project.placeholder && <span class="sample">{t.projects.sample}</span>}
  </div>
  <div class="content">
    <p class="meta">{project.year} · {project.type}</p>
    <h3>{project.name}</h3>
    <p class="summary">{project.summary}</p>
    <div class="tags">{project.skills.slice(0, 4).map((s) => <Tag>{s}</Tag>)}</div>
  </div>
</article>

<dialog id={dialogId} class="dialog" aria-labelledby={`${dialogId}-title`}>
  <div class="dialog-body">
    <button class="close" type="button" data-close-dialog aria-label={t.projects.close}>×</button>
    <p class="meta">{project.year} · {project.type}{project.role ? ` · ${project.role}` : ''}</p>
    <h3 id={`${dialogId}-title`}>{project.name}</h3>
    {project.placeholder && <p class="sample-note">{t.projects.sample}</p>}
    <div class="tags">{project.skills.map((s) => <Tag tone="accent">{s}</Tag>)}</div>
    <div class="prose"><Content /></div>
    <div class="links">
      {project.repo && <a href={project.repo} target="_blank" rel="noopener noreferrer">{t.projects.code} ↗</a>}
      {project.live && <a href={project.live} target="_blank" rel="noopener noreferrer">{t.projects.live} ↗</a>}
    </div>
  </div>
</dialog>

<style>
  .card { position: relative; display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: var(--radius-lg); background: color-mix(in oklab, var(--surface) 88%, transparent); overflow: hidden; transition: transform 0.35s var(--ease), border-color 0.25s, box-shadow 0.3s; }
  .card:hover { transform: translateY(-4px); border-color: color-mix(in oklab, var(--accent) 55%, var(--border)); box-shadow: 0 24px 50px -28px var(--accent); }
  .open { position: absolute; inset: 0; z-index: 1; background: transparent; border: 0; cursor: pointer; border-radius: inherit; }
  .media { position: relative; aspect-ratio: 16 / 9; display: grid; place-items: center; overflow: hidden; background: linear-gradient(135deg, hsl(var(--seed) 70% 22%), hsl(calc(var(--seed) + 60) 70% 12%)); }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .card:hover .media img { transform: scale(1.04); }
  .mono { font-family: var(--font-display); font-size: 3rem; font-weight: 700; color: rgb(255 255 255 / 0.85); letter-spacing: -0.04em; }
  .sample { position: absolute; top: 10px; right: 10px; padding: 0.15rem 0.6rem; border-radius: var(--radius-pill); background: rgb(0 0 0 / 0.55); backdrop-filter: blur(6px); border: 1px dashed var(--text-muted); font-family: var(--font-mono); font-size: 0.7rem; color: var(--text); }
  .content { display: grid; gap: var(--space-3); padding: var(--space-6); flex: 1; align-content: start; }
  .meta { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.08em; }
  h3 { font-size: 1.3rem; }
  .summary { color: var(--text-muted); font-size: 0.95rem; display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }

  .dialog { width: min(680px, calc(100% - 2rem)); max-height: 86vh; padding: 0; border: 1px solid var(--border-strong); border-radius: var(--radius-lg); background: var(--surface); color: var(--text); box-shadow: 0 40px 100px -20px #000; }
  .dialog::backdrop { background: rgb(3 5 8 / 0.7); backdrop-filter: blur(6px); }
  .dialog-body { position: relative; display: grid; gap: var(--space-4); padding: var(--space-8); }
  .close { position: absolute; top: 14px; right: 14px; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--border-strong); background: transparent; font-size: 1.3rem; cursor: pointer; }
  .close:hover { border-color: var(--accent); }
  .sample-note { color: var(--accent-2); font-family: var(--font-mono); font-size: 0.8rem; }
  .prose { display: grid; gap: var(--space-3); color: var(--text-muted); }
  .links { display: flex; gap: var(--space-6); font-weight: 500; }
  .links a { color: var(--accent); } .links a:hover { text-decoration: underline; }
</style>
