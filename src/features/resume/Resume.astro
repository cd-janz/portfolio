---
import { SITE } from '../../config/site';
import { durationBetween, formatDuration, formatMonthYear, parseDate } from '../../domain/dates';
import type { Education } from '../../schemas/education';
import type { Experience } from '../../schemas/experience';
import type { Profile } from '../../schemas/profile';
import type { ProjectItem } from '../../data/queries';
import type { SkillGroup } from '../../domain/skills';
import { localePath } from '../../i18n/paths';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale: Locale;
  profile: Profile;
  experience: (Experience & { id: string })[];
  education: (Education & { id: string })[];
  projects: ProjectItem[];
  groups: SkillGroup[];
}
const { locale, profile, experience, education, projects, groups } = Astro.props;
const t = ui(locale);
const period = (start: string, end?: string) =>
  `${formatMonthYear(start, locale)} – ${end ? formatMonthYear(end, locale) : t.resumePage.present}`;
const withStatus = (name: string, status: string) => (status === 'learning' ? `${name} (${t.skills.learning.toLowerCase()})` : name);
const skillLines = groups
  .filter((g) => g.items.length)
  .map((g) => {
    const items = g.items.map((i) => withStatus(i.name, i.status));
    // A group that only repeats its own name (e.g. Python) reads better without the label.
    return { title: items.length === 1 && g.items[0].name === g.title ? '' : g.title, items: items.join(', ') };
  });
const realProjects = projects.filter((p) => !p.placeholder);
---
<div class="toolbar">
  <a href={localePath(locale)}>← {t.resumePage.back}</a>
  <button type="button" data-print>{t.resumePage.print}</button>
</div>

<article class="sheet">
  <header class="top">
    <h1>{profile.firstName} {profile.lastName}</h1>
    <p class="role">{profile.role}</p>
    <ul class="contact">
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li><a href={SITE.phone.href}>{SITE.phone.display}</a></li>
      <li><a href={SITE.social.linkedin}>linkedin.com/in/juanzuniga79</a></li>
      <li><a href={SITE.social.github}>github.com/{SITE.handle}</a></li>
      <li>{profile.location}</li>
    </ul>
  </header>

  <p class="summary">{profile.tagline}</p>

  <section>
    <h2>{t.resumePage.experience}</h2>
    {experience.map((e) => (
      <div class="item">
        <div class="row"><h3>{e.role} · {e.company}</h3><span>{period(e.start, e.end)} · {formatDuration(durationBetween(parseDate(e.start), e.end ? parseDate(e.end) : new Date()), locale)}</span></div>
        <p class="sub">{e.location} · {e.mode}</p>
        <p>{e.summary}</p>
        <ul class="bullets">{e.achievements.map((a) => <li>{a}</li>)}</ul>
        <p class="stack"><b>{t.resumePage.skills}:</b> {e.stack.join(', ')}</p>
      </div>
    ))}
  </section>

  {realProjects.length > 0 && (
    <section>
      <h2>{t.resumePage.projects}</h2>
      {realProjects.map((p) => (
        <div class="item">
          <div class="row"><h3>{p.name}</h3><span>{p.year}</span></div>
          <p>{p.summary}</p>
          {p.repo && <p class="sub">{p.repo}</p>}
        </div>
      ))}
    </section>
  )}

  <section>
    <h2>{t.resumePage.education}</h2>
    {education.map((e) => (
      <div class="item">
        <div class="row"><h3>{e.program} · {e.institution}</h3><span>{formatMonthYear(e.start, locale)} – {e.status}</span></div>
        <p>{e.summary}</p>
      </div>
    ))}
  </section>

  <section>
    <h2>{t.resumePage.skills}</h2>
    {skillLines.map((l) => <p class="skill-line">{l.title && <b>{l.title}: </b>}{l.items}</p>)}
    <p class="sub">{profile.languages.map((l) => `${l.name}: ${l.level}`).join(' · ')}</p>
  </section>
</article>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style is:global>
  body { background: var(--bg); }
</style>
<style>
  .toolbar { width: min(100% - 2rem, 820px); margin: var(--space-6) auto; display: flex; justify-content: space-between; align-items: center; }
  .toolbar a { color: var(--text-muted); } .toolbar a:hover { color: var(--text); }
  .toolbar button { padding: 0.6rem 1.3rem; border: 0; border-radius: var(--radius-pill); background: var(--accent); color: #06090f; font-weight: 600; cursor: pointer; }
  .sheet { width: min(100% - 2rem, 820px); margin: 0 auto var(--space-16); padding: clamp(1.5rem, 5vw, 3.5rem); background: #fff; color: #14181f; border-radius: var(--radius); font-size: 0.95rem; line-height: 1.55; }
  .sheet a { color: inherit; text-decoration: underline; text-decoration-color: #c4cad4; }
  h1, h2, h3 { font-family: var(--font-body); }
  h1 { font-size: 2.2rem; }
  .role { color: #157fae; font-weight: 600; margin-top: 4px; }
  .contact { display: flex; flex-wrap: wrap; gap: 4px 18px; margin-top: 10px; font-size: 0.85rem; color: #4b5563; }
  .summary { margin-top: 18px; color: #374151; }
  section { margin-top: 26px; }
  h2 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.14em; color: #157fae; border-bottom: 1px solid #e5e7eb; padding-bottom: 6px; margin-bottom: 14px; }
  .item { margin-bottom: 18px; break-inside: avoid; }
  .row { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; align-items: baseline; }
  h3 { font-size: 1.02rem; letter-spacing: 0; }
  .row span, .sub { font-size: 0.82rem; color: #6b7280; }
  .bullets { margin: 6px 0 6px 1.1rem; list-style: disc; display: grid; gap: 3px; }
  .skill-line { margin-bottom: 4px; }
  .stack { font-size: 0.85rem; color: #4b5563; }

  @media print {
    .toolbar { display: none; }
    body { background: #fff; }
    .sheet { width: 100%; margin: 0; padding: 0; border-radius: 0; }
    @page { margin: 14mm; }
  }
</style>
