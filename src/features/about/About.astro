---
import { Image } from 'astro:assets';
import Section from '../../ui/Section.astro';
import portrait from '../../assets/profile.jpg';
import type { Profile } from '../../schemas/profile';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';

interface Props { locale: Locale; profile: Profile; }
const { locale, profile } = Astro.props;
const t = ui(locale);
---
<Section id="about" eyebrow={t.sections.about} title={profile.aboutTitle}>
  <div class="layout">
    <aside class="card profile">
      <Image src={portrait} alt={`${profile.firstName} ${profile.lastName}`} width={360} height={360} class="photo" />
      <h3>{profile.firstName} {profile.lastName}</h3>
      <p class="role">{profile.role}</p>
    </aside>

    <div class="body">
      <div class="prose">
        {profile.about.map((p) => <p>{p}</p>)}
      </div>
      <ul class="facts">
        {profile.languages.map((l) => <li><span>{l.name}</span><b>{l.level}</b></li>)}
        <li class="mode">{profile.workMode}</li>
      </ul>
    </div>
  </div>
</Section>

<style>
  .layout { display: grid; grid-template-columns: 300px 1fr; gap: var(--space-8); align-items: stretch; }
  .card { border: 1px solid var(--border); background: color-mix(in oklab, var(--surface) 85%, transparent); border-radius: var(--radius-lg); padding: var(--space-6); }
  .profile { display: flex; flex-direction: column; gap: var(--space-3); }
  .photo { width: 100%; flex: 1; min-height: 240px; object-fit: cover; object-position: center top; border-radius: var(--radius); }
  .role { color: var(--accent); font-family: var(--font-mono); font-size: 0.85rem; }
  .facts { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .facts li { display: inline-flex; gap: var(--space-2); align-items: baseline; padding: 0.4rem 0.9rem; border: 1px solid var(--border-strong); border-radius: var(--radius-pill); font-size: 0.9rem; color: var(--text-muted); }
  .facts b { color: var(--text); font-weight: 500; }
  .body { display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-8); }
  .prose { display: grid; gap: var(--space-4); font-size: 1.08rem; color: var(--text-muted); max-width: 66ch; }
  .prose p:first-child { color: var(--text); font-size: 1.2rem; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } .profile { display: grid; grid-template-columns: 120px 1fr; align-items: center; } .photo { grid-row: span 2; flex: none; min-height: 0; aspect-ratio: 1; height: auto; } }
</style>
