---
import { Image } from 'astro:assets';
import Section from '../../ui/Section.astro';
import Tag from '../../ui/Tag.astro';
import portrait from '../../assets/profile.jpg';
import type { Profile } from '../../schemas/profile';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';

interface Props { locale: Locale; profile: Profile; }
const { locale, profile } = Astro.props;
const t = ui(locale);
---
<Section id="about" eyebrow={t.sections.about} title={profile.aboutTitle}>
  <div class="layout">
    <aside class="card profile">
      <Image src={portrait} alt={`${profile.firstName} ${profile.lastName}`} width={360} height={360} class="photo" />
      <h3>{profile.firstName} {profile.lastName}</h3>
      <p class="role">{profile.role}</p>
      <ul class="facts">
        {profile.languages.map((l) => <li><span>{l.name}</span><b>{l.level}</b></li>)}
      </ul>
      <p class="mode">{profile.workMode}</p>
    </aside>

    <div class="body">
      <div class="prose">
        {profile.about.map((p) => <p>{p}</p>)}
      </div>
      <ul class="focus">
        {profile.focus.map((f) => (
          <li class="card">
            <h3>{f.title}</h3>
            <p>{f.description}</p>
            <div class="tags">{f.skills.map((s) => <Tag>{s}</Tag>)}</div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>

<style>
  .layout { display: grid; grid-template-columns: 300px 1fr; gap: var(--space-8); align-items: start; }
  .card { border: 1px solid var(--border); background: color-mix(in oklab, var(--surface) 85%, transparent); border-radius: var(--radius-lg); padding: var(--space-6); }
  .profile { display: grid; gap: var(--space-3); position: sticky; top: calc(var(--header-h) + 16px); }
  .photo { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); }
  .role { color: var(--accent); font-family: var(--font-mono); font-size: 0.85rem; }
  .facts li { display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed var(--border); font-size: 0.92rem; color: var(--text-muted); }
  .facts b { color: var(--text); font-weight: 500; }
  .mode { font-size: 0.85rem; color: var(--text-muted); }
  .body { display: grid; gap: var(--space-8); }
  .prose { display: grid; gap: var(--space-4); font-size: 1.08rem; color: var(--text-muted); max-width: 66ch; }
  .prose p:first-child { color: var(--text); font-size: 1.2rem; }
  .focus { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: var(--space-4); }
  .focus .card { display: grid; gap: var(--space-3); align-content: start; transition: border-color 0.25s, transform 0.3s var(--ease); }
  .focus .card:hover { border-color: color-mix(in oklab, var(--accent) 50%, var(--border)); transform: translateY(-3px); }
  .focus p { color: var(--text-muted); font-size: 0.95rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } .profile { position: static; grid-template-columns: 120px 1fr; align-items: center; } .photo { grid-row: span 3; } .facts, .mode { grid-column: 2; } }
</style>
