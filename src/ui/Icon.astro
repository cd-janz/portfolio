---
import { svg } from './svg-registry';

interface Props { name: string; size?: string; label?: string; class?: string; }
const { name, size = '1.25em', label, class: className } = Astro.props;
---
<span class:list={['icon', className]} style={`--size:${size}`} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} set:html={svg(name)} />

<style is:global>
  .icon { display: inline-flex; flex: none; width: var(--size, 1.25em); height: var(--size, 1.25em); }
  .icon > svg { width: 100%; height: 100%; }
</style>
