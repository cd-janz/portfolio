---
interface Props { id: string; eyebrow: string; title?: string; wide?: boolean; }
const { id, eyebrow, title, wide = false } = Astro.props;
---
<section {id} aria-labelledby={`${id}-title`} class="section">
  <div class="container">
    <header class="head">
      <p class="eyebrow"><span aria-hidden="true">/</span> {eyebrow}</p>
      <h2 id={`${id}-title`} class:list={{ 'sr-only': !title }}>{title ?? eyebrow}</h2>
    </header>
  </div>
  <div class:list={['container', { wide }]}>
    <slot />
  </div>
</section>

<style>
  .section { padding-block: var(--space-24); position: relative; }
  .head { margin-bottom: var(--space-12); display: grid; gap: var(--space-3); }
  .eyebrow { font-family: var(--font-mono); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent); }
  h2 { font-size: clamp(1.9rem, 4vw, 2.9rem); max-width: 22ch; }
</style>
