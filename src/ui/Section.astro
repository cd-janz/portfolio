---
import MoreLink from './MoreLink.astro';
interface Props { id: string; eyebrow: string; title?: string; wide?: boolean; more?: { href: string; label: string }; }
const { id, eyebrow, title, wide = false, more } = Astro.props;
---
<section {id} aria-labelledby={`${id}-title`} class="section">
  <div class="container">
    <header class="head">
      <p class="eyebrow"><span aria-hidden="true">/</span> {eyebrow}</p>
      <h2 id={`${id}-title`} class:list={{ 'sr-only': !title }}>{title ?? eyebrow}</h2>
    </header>
  </div>
  <div class:list={['container', { wide }]}>
    <slot />
    {more && <p class="more-row"><MoreLink href={more.href}>{more.label}</MoreLink></p>}
  </div>
</section>

<style>
  .section { padding-block: var(--space-24); position: relative; }
  .more-row { margin-top: var(--space-8); display: flex; justify-content: flex-end; }
  .head { margin-bottom: var(--space-12); display: grid; gap: var(--space-3); }
  .eyebrow { font-family: var(--font-mono); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent); }
  h2 { font-size: clamp(2.8rem, 6vw, 4.4rem); max-width: 20ch; line-height: 0.95; }
</style>
