---
import type { Locale } from '../i18n/locales';
import Head from './Head.astro';

/** Minimal shell for standalone pages (resume, 404): no landing chrome. */
interface Props { locale: Locale; title: string; description: string; jobTitle: string; path?: string; noindex?: boolean; }
const { locale, ...head } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head><Head {locale} {...head} /></head>
  <body><main id="main"><slot /></main></body>
</html>
