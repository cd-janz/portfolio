---
import '@fontsource-variable/inter';
import '@fontsource-variable/teko';
import '@fontsource-variable/jetbrains-mono';
import '../styles/base.css';
import Seo from '../features/seo/Seo.astro';
import type { Locale } from '../i18n/locales';

interface Props { locale: Locale; title: string; description: string; jobTitle: string; path?: string; noindex?: boolean; }
const { noindex, ...seo } = Astro.props;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex" />}
<Seo {...seo} />
