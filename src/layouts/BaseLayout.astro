---
import Background from '../features/background/Background.astro';
import Footer from '../features/footer/Footer.astro';
import Header from '../features/header/Header.astro';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
import Head from './Head.astro';

interface Props { locale: Locale; title: string; description: string; jobTitle: string; }
const { locale, ...head } = Astro.props;
const t = ui(locale);
---
<!doctype html>
<html lang={locale}>
  <head><Head {locale} {...head} /></head>
  <body>
    <a class="skip sr-only" href="#main">{t.skipToContent}</a>
    <Background />
    <Header {locale} />
    <main id="main"><slot /></main>
    <Footer {locale} />
  </body>
</html>

<style is:global>
  .skip:focus { position: fixed; top: 8px; left: 8px; z-index: 100; width: auto; height: auto; margin: 0; padding: 0.6rem 1rem; clip: auto; background: var(--accent); color: #06090f; border-radius: var(--radius-sm); }
</style>
